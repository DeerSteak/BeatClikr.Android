#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

markdown_files=()
while IFS= read -r file; do
    markdown_files+=("$file")
done < <(git ls-files --cached --others --exclude-standard -- '*.md')

if ((${#markdown_files[@]} == 0)); then
    exit 0
fi

before_hash="$(shasum -a 256 "${markdown_files[@]}" | shasum -a 256)"
python3 tools/format_markdown.py "${markdown_files[@]}"
after_hash="$(shasum -a 256 "${markdown_files[@]}" | shasum -a 256)"

if [[ "$before_hash" != "$after_hash" ]]; then
    echo "Markdown was reformatted without hard wrapping."
    echo "Review and stage the changed files, then commit again."
    exit 1
fi
